{
    "enginesDir": "../engines",
    "modelsDir": "../models",
    "modulesDir": "../modules",

    "app": {
        "port": 14000,
        "verbose": false,
        "startTimeout": 60,
        "engine": "ubuntu-vulkan-llama",
        "model": "Qwen3-0.6B-Q8_0.gguf",
        
        "main": {
            "name": "ui",
            "configuration": {
                "port": 8080,
                "history": "short_history",
                "context": "context"
            }
        },

        "helpers": {
            "short_history": {
                "name": "history",
                "configuration": {
                    "size": 100,
                    "store":  true
                }
            },
            "context": {
                "name": "context",
                "configuration": {
                    "store": true,
                    "useMemory": true
                }
            },
            "knowledge": {
                "name": "knowledge",
                "configuration": {
                    "allowAppend": true,
                    "maxAppendixSize": 262144,
                    "searchLimit": 5
                }
            }
        }
    }
}